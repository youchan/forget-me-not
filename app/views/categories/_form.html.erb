<%= form_with model: category, class: "space-y-5" do |f| %>
  <% if category.errors.any? %>
    <p class="py-2 px-3 bg-red-50 mb-2 text-red-600 font-medium rounded-md">
      <%= category.errors.full_messages.join("、") %>
    </p>
  <% end %>

  <div>
    <%= f.label :name, "カテゴリ名", class: "block font-medium mb-1" %>
    <%= f.text_field :name, autofocus: true,
          class: "block shadow-sm rounded-md border border-gray-400 outline-none px-3 py-2 w-full" %>
  </div>

  <div class="flex gap-2">
    <%= f.submit "保存", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <%= link_to "やめる", categories_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium" %>
  </div>
<% end %>
