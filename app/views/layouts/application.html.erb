<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Forget Me Not" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Forget Me Not">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="<%= asset_path("icon.png", skip_pipeline: true) %>" type="image/png">
    <link rel="icon" href="<%= asset_path("icon.svg", skip_pipeline: true) %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= asset_path("icon.png", skip_pipeline: true) %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="container mx-auto px-5 pt-5 flex justify-between items-center">
      <%= link_to "Forget Me Not", logged_in? ? tasks_path : sign_in_path, class: "font-bold text-xl" %>
      <% if logged_in? %>
        <div class="flex items-center gap-4">
          <%= form_with url: tasks_path, method: :get, data: { controller: "auto-submit" } do |f| %>
            <%= f.select :category_id,
                  options_for_select(
                    [ [ "すべて", "" ] ] + current_user.categories.ordered.map { |c| [ c.name, c.id ] },
                    active_category_id.to_s
                  ),
                  {},
                  class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm cursor-pointer",
                  data: { action: "change->auto-submit#submit" } %>
          <% end %>
          <span class="text-gray-600"><%= current_user.email %></span>
          <div class="relative" data-controller="menu">
            <button type="button" data-action="click->menu#toggle" aria-label="メニュー"
                    class="rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-50 font-medium cursor-pointer">
              ☰
            </button>
            <div data-menu-target="menu"
                 class="hidden absolute right-0 top-full mt-2 w-44 bg-white border border-gray-200 rounded-md shadow-lg py-1 z-10">
              <%= link_to "カテゴリを編集", categories_path, class: "block px-4 py-2 text-sm hover:bg-gray-50" %>
              <%= link_to "タグを編集", tags_path, class: "block px-4 py-2 text-sm hover:bg-gray-50" %>
              <%= button_to "ログアウト", sign_out_path, method: :delete,
                    class: "block w-full text-left px-4 py-2 text-sm hover:bg-gray-50 bg-transparent cursor-pointer" %>
            </div>
          </div>
        </div>
      <% end %>
    </header>

    <main class="container mx-auto mt-10 px-5 flex">
      <div class="w-full">
        <% if notice.present? %>
          <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block"><%= notice %></p>
        <% end %>
        <% if alert.present? %>
          <p class="py-2 px-3 bg-red-50 mb-5 text-red-600 font-medium rounded-md inline-block"><%= alert %></p>
        <% end %>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
