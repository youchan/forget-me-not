<% content_for :title, "ログイン" %>

<div class="w-full max-w-md mx-auto" data-controller="webauthn-login">
  <h1 class="font-bold text-4xl mb-6">ログイン</h1>

  <p data-webauthn-login-target="error" class="hidden py-2 px-3 bg-red-50 mb-5 text-red-600 font-medium rounded-md"></p>

  <form data-action="submit->webauthn-login#login" class="space-y-5">
    <div>
      <label class="block font-medium mb-1" for="email">メールアドレス</label>
      <input type="email" id="email" required autocomplete="email webauthn"
        data-webauthn-login-target="email"
        class="block shadow-sm rounded-md border border-gray-400 outline-none px-3 py-2 w-full">
    </div>

    <button type="submit" data-webauthn-login-target="submit"
      class="rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium w-full cursor-pointer disabled:opacity-50">
      パスキーでログイン
    </button>
  </form>

  <p class="mt-5 text-center">
    アカウントまだ持ってない?
    <%= link_to "新規登録", sign_up_path, class: "text-blue-600 font-medium" %>
  </p>
</div>
